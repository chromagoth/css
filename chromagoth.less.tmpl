// @chromagoth/css — generated by chromagoth CLI — do not edit
// ash #6a6c70 is the universal anchor across all variants
{{ range .palettes }}
// {{ .name }} — {{ .style }}
[data-theme="{{ .variant }}"] {
  --ground: {{ hex .surface.base }};
  --veil: {{ hex .surface.raised }};
  --field: {{ hex .surface.overlay }};
  --trace: {{ hex .surface.border }};
  --ash: {{ hex .text.disabled }};
  --mist: {{ hex .text.subtle }};
  --haze: {{ hex .text.dim }};
  --graphite: {{ hex .text.default }};
  --circuit-lime: {{ hex .accent.positive }};
  --powder-blush: {{ hex .accent.caution }};
  --static-mint: {{ hex .accent.info }};
  --laser-blue: {{ hex .accent.link }};
  --cyber-pink: {{ hex .accent.primary }};
  --ultraviolet: {{ hex .accent.secondary }};
  --amber-glow: {{ hex .accent.warning }};
  --cherry-flux: {{ hex .accent.danger }};
}
{{ end }}
// LESS flat variables — @chromagoth-cyber-ground, etc.
{{ range .palettes }}@chromagoth-{{ .variant }}-ground:       {{ hex .surface.base }};
@chromagoth-{{ .variant }}-veil:         {{ hex .surface.raised }};
@chromagoth-{{ .variant }}-field:        {{ hex .surface.overlay }};
@chromagoth-{{ .variant }}-trace:        {{ hex .surface.border }};
@chromagoth-{{ .variant }}-ash:          {{ hex .text.disabled }};
@chromagoth-{{ .variant }}-mist:         {{ hex .text.subtle }};
@chromagoth-{{ .variant }}-haze:         {{ hex .text.dim }};
@chromagoth-{{ .variant }}-graphite:     {{ hex .text.default }};
@chromagoth-{{ .variant }}-circuit-lime: {{ hex .accent.positive }};
@chromagoth-{{ .variant }}-powder-blush: {{ hex .accent.caution }};
@chromagoth-{{ .variant }}-static-mint:  {{ hex .accent.info }};
@chromagoth-{{ .variant }}-laser-blue:   {{ hex .accent.link }};
@chromagoth-{{ .variant }}-cyber-pink:   {{ hex .accent.primary }};
@chromagoth-{{ .variant }}-ultraviolet:  {{ hex .accent.secondary }};
@chromagoth-{{ .variant }}-amber-glow:   {{ hex .accent.warning }};
@chromagoth-{{ .variant }}-cherry-flux:  {{ hex .accent.danger }};
{{ end }}